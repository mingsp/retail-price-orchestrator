MASTER_BASE_URL=https://<MASTER_HOST>
WORKER_IDENTITY_FILE=.runtime/worker-identity.json
WORKER_ENROLLMENT_TOKEN=<ONE_TIME_ENROLLMENT_TOKEN>
WORKER_TOKEN=<WORKER_TOKEN_FROM_MASTER>
WORKER_REMOTE_DESKTOP_PROVIDER=<rdp_or_screen_sharing>
WORKER_REMOTE_DESKTOP_TARGET=<WORKER_LAN_ADDRESS>
WORKER_HEARTBEAT_INTERVAL_MS=10000
WORKER_ENABLE_TASK_POLLING=false
WORKER_ENABLE_TASK_EXECUTION=false
WORKER_TASK_POLLING_INTERVAL_MS=30000
WORKER_CAPTURE_CONCURRENCY=4
WORKER_CAPTURE_QUEUE_MAX=4
WORKER_PRODUCT_PIPELINE_CONCURRENCY=1
WORKER_PRODUCT_PIPELINE_QUEUE_MAX=8
WORKER_COLLECTOR_ADAPTER=native
WORKER_NATIVE_SCRIPT_ROOT=scripts
WORKER_NATIVE_SCRIPT_NAME=native-cdp-store-capture.mjs
WORKER_NATIVE_OUTPUT_ROOT=.runtime/native-capture
WORKER_NATIVE_DELAY_MIN_MS=45000
WORKER_NATIVE_DELAY_MAX_MS=120000
WORKER_NATIVE_CATEGORY_REST_MIN_MS=90000
WORKER_NATIVE_CATEGORY_REST_MAX_MS=240000
WORKER_NATIVE_RISK_SLEEP_MS=3600000
WORKER_NATIVE_DYNAMIC_CHUNK_MODE=balanced
WORKER_NATIVE_ALLOW_PAGE_FALLBACK=false
